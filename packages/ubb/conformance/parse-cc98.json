{
  "schema": "ubb-conformance/1",
  "specVersion": "1.0.0",
  "kind": "parse-cc98",
  "cases": [
    {
      "name": "static-recursive",
      "input": "[b]x[/b]",
      "expected": [
        {
          "type": "tag",
          "tag": "b",
          "family": null,
          "attrs": {
            "positionals": [],
            "named": {}
          },
          "raw": {
            "open": "[b]",
            "close": "[/b]"
          },
          "children": [
            {
              "type": "text",
              "value": "x"
            }
          ]
        }
      ]
    },
    {
      "name": "color-position",
      "input": "[color=red]x[/color]",
      "expected": [
        {
          "type": "tag",
          "tag": "color",
          "family": null,
          "attrs": {
            "positionals": ["red"],
            "named": {}
          },
          "raw": {
            "open": "[color=red]",
            "close": "[/color]"
          },
          "children": [
            {
              "type": "text",
              "value": "x"
            }
          ]
        }
      ]
    },
    {
