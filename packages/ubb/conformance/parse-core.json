          ]
        },
        {
          "type": "text",
          "value": "c"
        },
        {
          "type": "text",
          "value": "[/md]"
        }
      ]
    },
    {
      "name": "empty-tag",
      "input": "[line]",
      "expected": [
        {
          "type": "tag",
          "tag": "line",
          "family": null,
          "attrs": {
            "positionals": [],
            "named": {}
          },
          "raw": {
            "open": "[line]",
            "close": null
          },
          "children": []
        }
      ]
    },
    {
      "name": "empty-tag-with-end",
      "input": "[line][/line]",
