        {
          "type": "text",
          "value": "abc"
        }
      ]
    },
    {
      "name": "text-mode-empty",
      "input": "[code][/code]",
      "expected": [
        {
          "type": "tag",
          "tag": "code",
          "family": null,
          "attrs": {
            "positionals": [],
            "named": {}
          },
          "raw": {
            "open": "[code]",
            "close": "[/code]"
          },
          "children": []
        }
      ]
    },
    {
      "name": "text-mode-inner-partial-end",
      "input": "[md]x[/ncode]y[/md]",
