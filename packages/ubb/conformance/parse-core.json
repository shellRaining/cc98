        {
          "type": "tag",
          "tag": "md",
          "family": null,
          "attrs": {
            "positionals": [],
            "named": {}
          },
          "raw": {
            "open": "[md]",
            "close": "[/md]"
          },
          "children": [
            {
              "type": "text",
              "value": "x[/ncode]y"
            }
          ]
        }
      ]
    },
    {
      "name": "text-mode-nested-same-name",
      "input": "[md]a[md]b[/md]c[/md]",
      "expected": [
        {
          "type": "tag",
          "tag": "md",
          "family": null,
          "attrs": {
            "positionals": [],
            "named": {}
          },
          "raw": {
            "open": "[md]",
            "close": "[/md]"
          },
          "children": [
            {
              "type": "text",
