{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "cd ../../.. && bash scripts/vercel-ignore.sh api-docs",
  "installCommand": "true",
  "buildCommand": "mkdir -p dist && cp ../generated/openapi.json ../generated/openid.openapi.json dist/",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/openapi.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/openid.openapi.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
